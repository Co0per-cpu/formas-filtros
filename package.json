{
  "name": "formas-filtros",
  "version": "1.1.0",
  "description": "Formas y Filtros: efectos de cámara con seguimiento de manos",
  "author": "Co0per-cpu",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-web": "node prepare.js",
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "peerjs": "1.5.4",
    "qrcode-generator": "1.4.4"
  },
  "build": {
    "appId": "io.github.co0per-cpu.formasfiltros",
    "productName": "Formas y Filtros",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "vcam.js",
      "web/**"
    ],
    "win": {
      "target": "portable",
      "icon": "icon-512.png"
    },
    "portable": {
      "artifactName": "FormasYFiltros.exe"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "koffi": "^2.9.0"
  }
}
